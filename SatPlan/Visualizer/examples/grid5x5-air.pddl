;; grid5x5-air
;; 5 x 5 grid of places, roads between adjacent cells;
;; 2 airports placed to maximize their minimum separation (8);
;; 2 trucks and 3 packages placed at random, 1 airplane over the airports.
;; Knockout 30%: 28 of 40 roads kept -- a random spanning tree plus random others, so every place stays reachable by road.
;; 2 destinations per package; reaching any one of them counts.
;;
;; Generated by ppgen.sh -- edit the generator, not this file.
;; Every setting used, defaults included; re-run with these to reproduce it:
;;
;;   --style grid
;;   --dimensions 5 5
;;   --airports 2
;;   --trucks 2
;;   --airplanes 1
;;   --packages 3
;;   --drive-cost 1
;;   --fly-cost 3
;;   --preferences none
;;   --destinations 2
;;   --require all
;;   --knockout 30
;;   --seed 7

(define (problem grid5x5-air)
  (:domain clara-logistics)

  (:objects
        p1-1 p1-2 p1-3 p1-4 p2-1 p2-2 p2-3 p2-4 p2-5 p3-1 p3-2 p3-3 p3-4 p3-5 p4-1 p4-2 p4-3 p4-4 p4-5 p5-2 p5-3 p5-4 p5-5 - place
        p5-1 p1-5 - airport
        truck1 truck2 - truck
        plane1 - airplane
        pkg1 pkg2 pkg3 - package)

  (:init
        ;; where everything starts
        (at pkg1 p4-3)
        (at pkg2 p3-5)
        (at pkg3 p3-1)
        (at truck1 p2-1)
        (at truck2 p3-2)
        (at plane1 p1-5)

        ;; static topology: roads within each road network,
        ;; routes between every pair of airports
        (road p2-1 p1-1)
        (road p1-1 p2-1)
        (road p2-2 p1-2)
        (road p1-2 p2-2)
        (road p1-3 p1-2)
        (road p1-2 p1-3)
        (road p2-3 p1-3)
        (road p1-3 p2-3)
        (road p1-4 p1-3)
        (road p1-3 p1-4)
        (road p2-4 p1-4)
        (road p1-4 p2-4)
        (road p1-5 p1-4)
        (road p1-4 p1-5)
        (road p3-1 p2-1)
        (road p2-1 p3-1)
        (road p2-2 p2-1)
        (road p2-1 p2-2)
        (road p3-2 p2-2)
        (road p2-2 p3-2)
        (road p3-3 p2-3)
        (road p2-3 p3-3)
        (road p2-4 p2-3)
        (road p2-3 p2-4)
        (road p2-5 p2-4)
        (road p2-4 p2-5)
        (road p3-5 p2-5)
        (road p2-5 p3-5)
        (road p4-1 p3-1)
        (road p3-1 p4-1)
        (road p4-2 p3-2)
        (road p3-2 p4-2)
        (road p4-3 p3-3)
        (road p3-3 p4-3)
        (road p4-4 p3-4)
        (road p3-4 p4-4)
        (road p3-5 p3-4)
        (road p3-4 p3-5)
        (road p4-5 p3-5)
        (road p3-5 p4-5)
        (road p5-1 p4-1)
        (road p4-1 p5-1)
        (road p4-2 p4-1)
        (road p4-1 p4-2)
        (road p5-3 p4-3)
        (road p4-3 p5-3)
        (road p5-5 p4-5)
        (road p4-5 p5-5)
        (road p5-2 p5-1)
        (road p5-1 p5-2)
        (road p5-3 p5-2)
        (road p5-2 p5-3)
        (road p5-4 p5-3)
        (road p5-3 p5-4)
        (road p5-5 p5-4)
        (road p5-4 p5-5)

        (route p5-1 p1-5)
        (route p1-5 p5-1)

        ;; travel prices: one value for every drive, one for every flight
        (= (total-cost) 0)
        (= (drive-cost) 1)
        (= (fly-cost) 3))

  (:goal (and
        (or (at pkg1 p3-3) (at pkg1 p2-1))
        (or (at pkg2 p2-5) (at pkg2 p3-1))
        (or (at pkg3 p1-4) (at pkg3 p2-4))))

  (:metric minimize (total-cost)))
