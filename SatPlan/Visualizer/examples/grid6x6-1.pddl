;; grid6x6-1
;; 6 x 6 grid of places, roads between adjacent cells;
;; no airports;
;; 2 trucks and 4 packages placed at random, 0 airplanes over the airports.
;; Knockout 40%: 36 of 60 roads kept -- a random spanning tree plus random others, so every place stays reachable by road.
;; 3 destinations per package; reaching any one of them counts.
;; At least one of the 4 packages must reach a destination.
;;
;; Generated by ppgen.sh -- edit the generator, not this file.
;; Every setting used, defaults included; re-run with these to reproduce it:
;;
;;   --style grid
;;   --dimensions 6 6
;;   --airports 0
;;   --trucks 2
;;   --airplanes 0
;;   --packages 4
;;   --drive-cost 2
;;   --fly-cost 3
;;   --preferences 8 8
;;   --destinations 3
;;   --require some
;;   --knockout 40
;;   --seed 1

(define (problem grid6x6-1)
  (:domain clara-logistics-handling)

  (:objects
        p1-1 p1-2 p1-3 p1-4 p1-5 p1-6 p2-1 p2-2 p2-3 p2-4 p2-5 p2-6 p3-1 p3-2 p3-3 p3-4 p3-5 p3-6 p4-1 p4-2 p4-3 p4-4 p4-5 p4-6 p5-1 p5-2 p5-3 p5-4 p5-5 p5-6 p6-1 p6-2 p6-3 p6-4 p6-5 p6-6 - place
        truck1 truck2 - truck
