;; grid3x3-1
;; 3 x 3 grid of places, roads between adjacent cells;
;; no airports;
;; 1 truck and 2 packages placed at random, 0 airplanes over the airports.
;; 2 destinations per package; reaching any one of them counts.
;; At least one of the 2 packages must reach a destination.
;;
;; Generated by ppgen.sh -- edit the generator, not this file.
;; Every setting used, defaults included; re-run with these to reproduce it:
;;
;;   --style grid
;;   --dimensions 3 3
;;   --airports 0
;;   --trucks 1
;;   --airplanes 0
;;   --packages 2
;;   --drive-cost 1
;;   --fly-cost 3
;;   --preferences none
;;   --destinations 2
;;   --require some
;;   --seed 1

(define (problem grid3x3-1)
  (:domain clara-logistics-old)

  (:objects
        p1-1 p1-2 p1-3 p2-1 p2-2 p2-3 p3-1 p3-2 p3-3 - place
        truck1 - truck
        pkg1 pkg2 - package)

  (:init
        ;; where everything starts
        (at pkg1 p3-3)
        (at pkg2 p2-3)
        (at truck1 p2-3)

        ;; static topology: roads within each road network,
        ;; routes between every pair of airports
        (road p2-1 p1-1)
        (road p1-1 p2-1)
        (road p1-2 p1-1)
        (road p1-1 p1-2)
        (road p2-2 p1-2)
        (road p1-2 p2-2)
        (road p1-3 p1-2)
        (road p1-2 p1-3)
        (road p2-3 p1-3)
        (road p1-3 p2-3)
        (road p3-1 p2-1)
        (road p2-1 p3-1)
        (road p2-2 p2-1)
        (road p2-1 p2-2)
        (road p3-2 p2-2)
        (road p2-2 p3-2)
        (road p2-3 p2-2)
        (road p2-2 p2-3)
        (road p3-3 p2-3)
        (road p2-3 p3-3)
        (road p3-2 p3-1)
        (road p3-1 p3-2)
        (road p3-3 p3-2)
        (road p3-2 p3-3)


        ;; travel prices: one value for every drive, one for every flight
        (= (total-cost) 0)
        (= (drive-cost) 1)
        (= (fly-cost) 3))

  (:goal (and
        (or (at pkg1 p1-3) (at pkg1 p2-1) (at pkg2 p2-1) (at pkg2 p1-1))))

  (:metric minimize (total-cost)))
