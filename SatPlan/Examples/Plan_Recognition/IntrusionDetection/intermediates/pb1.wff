;; FiFO SatPlan encoding generated by pddl2fifo
;; Problem intrusion-detection-10-hosts from pb1.pddl
;; Domain intrusion-detection from intrusion-detection.pddl

;; Time horizon -- numslices is taken from the Lisp variable
;; *satplan-numslices* when it is bound to an integer, else 2.
(alias numslices
 (lisp
  (if (and (boundp '*satplan-numslices*)
           (integerp (symbol-value '*satplan-numslices*)))
      (symbol-value '*satplan-numslices*)
      2)))
(domain slices (range 1 numslices))
(domain actslices (range 1 (- numslices 1)))

;; Objects
(domain objects
 (set perseus cassiopea andromeda sagittarius scorpio virgo aries leo libra
      taurus))

;; Type domains
(domain host
 (set perseus cassiopea andromeda sagittarius scorpio virgo aries leo libra
      taurus))

;; Static predicates (never added or deleted), with all
;; positive instances from the initial state.  The dummy
;; facts only register each predicate as static.
(static (dummy) (dummy))

;; Action preconditions, effects, and costs
(static
 (all h host true
  (if (and (dummy))
      (add (recon h) (recon-performed h))))
 (all h host true
  (and (pre (information-gathering h) (recon-performed h))
       (add (information-gathering h) (information-gathered h))))
 (all h host true
  (and (pre (break-into h) (recon-performed h))
       (add (break-into h) (access-obtained h))))
 (all h host true
  (and (pre (modify-files h) (access-obtained h))
       (add (modify-files h) (modified-files h))))
 (all h host true
  (and (pre (clean h) (access-obtained h)) (add (clean h) (deleted-logs h))))
 (all h host true
  (and (pre (vandalize h) (modified-files h))
       (pre (vandalize h) (deleted-logs h))
       (add (vandalize h) (vandalized h))))
 (all h host true
  (and (pre (gain-root h) (access-obtained h))
       (add (gain-root h) (root-access-obtained h))))
 (all h host true
  (and (pre (download-files h) (root-access-obtained h))
       (add (download-files h) (files-downloaded h))))
 (all h host true
  (and (pre (steal-data h) (files-downloaded h))
       (pre (steal-data h) (deleted-logs h))
       (add (steal-data h) (data-stolen-from h)))))

;; Initial and goal states
(domain goal-state
 (set (information-gathered perseus) (information-gathered cassiopea)
      (information-gathered andromeda) (information-gathered sagittarius)
      (information-gathered scorpio) (information-gathered virgo)
      (information-gathered aries) (information-gathered leo)
      (information-gathered libra) (information-gathered taurus)))

;; Domains derived from the static action schemas
(domain actions
 (union (collect a (pre a *))
        (union (collect a (add a *)) (collect a (del a *)))))
(domain fluents
 (union (collect f (pre * f))
        (union (collect f (add * f)) (union (collect f (del * f)) goal-state))))
(domain costs (collect c (cost * c)))
(domain initial-state (set-difference fluents fluents))

(include "satplan.wff")
