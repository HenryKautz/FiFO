;; FiFO SatPlan encoding generated by pddl2fifo
;; Problem pb1 from pb1.pddl
;; Domain blocks-dp from blocks-derived.pddl

;; Time horizon -- numslices is taken from the Lisp variable
;; *satplan-numslices* when it is bound to an integer, else 2.
(alias numslices
 (lisp
  (if (and (boundp '*satplan-numslices*)
           (integerp (symbol-value '*satplan-numslices*)))
      (symbol-value '*satplan-numslices*)
      2)))
(domain slices (range 1 numslices))
(domain actslices (range 1 (- numslices 1)))

;; Objects
(domain objects (set a b c))

;; Type domains
(domain block (set a b c))

;; Action preconditions, effects, and costs
(static
 (all x block true
  (and (pre (pick-up x) (clear x)) (pre (pick-up x) (ontable x))
       (pre (pick-up x) (handempty)) (add (pick-up x) (holding x))
       (del (pick-up x) (ontable x)) (del (pick-up x) (clear x))
       (del (pick-up x) (handempty))))
 (all x block true
  (and (pre (put-down x) (holding x)) (add (put-down x) (clear x))
       (add (put-down x) (handempty)) (add (put-down x) (ontable x))
       (del (put-down x) (holding x))))
 (all (x y) block true
  (and (pre (stack x y) (holding x)) (pre (stack x y) (clear y))
       (add (stack x y) (clear x)) (add (stack x y) (handempty))
       (add (stack x y) (on x y)) (del (stack x y) (holding x))
       (del (stack x y) (clear y))))
 (all (x y) block true
  (and (pre (unstack x y) (on x y)) (pre (unstack x y) (clear x))
       (pre (unstack x y) (handempty)) (add (unstack x y) (holding x))
       (add (unstack x y) (clear y)) (del (unstack x y) (clear x))
       (del (unstack x y) (handempty)) (del (unstack x y) (on x y)))))

;; Initial and goal states
(domain initial-state
 (set (handempty) (ontable a) (ontable b) (ontable c) (clear a) (clear b)
      (clear c)))
(domain goal-fluents (set (on b a) (ontable a)))

;; Domains derived from the static action schemas
(domain actions
 (union (collect a (pre a *))
        (union (collect a (add a *)) (collect a (del a *)))))
(domain fluents
 (union (collect f (pre * f))
        (union (collect f (add * f))
               (union (collect f (del * f))
                      (union initial-state goal-fluents)))))
(domain costs (collect c (cost * c)))
(domain goal-state (set-difference fluents fluents))

;; Goal (disjunctive/nested) asserted directly at the final slice
(or (holds (spells-ab) numslices)
    (and (holds (on b a) numslices) (holds (ontable a) numslices)))

;; Derived predicate definitions (:derived)
(all s slices true
 (all x block true
  (equiv (holds (clear-d x) s) (all y block true (not (holds (on y x) s))))))
(all s slices true
 (equiv (holds (spells-ab) s)
  (and (holds (on a b) s) (holds (ontable b) s) (holds (clear-d a) s))))

(include "satplan.wff")
