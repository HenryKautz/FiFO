# macOS
.DS_Store

# Claude Code local data
.claude/

# Editor / SBCL-alive workspace files and compiled artifacts
.vscode/
*.fasl

# Solver checkouts and build trees fetched by bin/install-solvers.sh
Solvers/

# Per-process scratch files from test-scnf (make-scratch-file-root writes
# "scratch-<universal-time>-<random>.{scnf,cnf,wcnf,map,satout,soln}" into the
# current directory, so they land wherever solve was run from).  Regenerable;
# bin/cleanupfifo.sh sweeps them.  Unanchored, since they appear in whichever
# directory the run started from, not only the repository root.
scratch-*

# Intermediates from the max-term back end: marginals-maxterm writes
# "<scnf-root>-maxterm.{wcnf,satout}" (plus "-maxterm-v.{cnf,satout}" for
# --verify-groups) beside the .scnf it was given, and -- unlike the ADDMC and
# MC-SAT bridges, which delete theirs -- it leaves them there.  Regenerable, and
# they land next to checked-in .scnf fixtures in Probability/, where they are easy
# to commit by accident.  Unanchored: the .scnf may live anywhere.
*-maxterm.wcnf
*-maxterm.satout
*-maxterm-v.cnf
*-maxterm-v.satout

# SatPlan/ is managed manually -- never ignore anything under it
!SatPlan/**

# ... except macOS turds, which the negation above would otherwise re-include,
# leaving them permanently untracked-but-listed in git status.  This must come
# AFTER the negation: git applies the last matching pattern.
SatPlan/**/.DS_Store
SatPlan/**/scratch-*
SatPlan/**/*-maxterm.wcnf
SatPlan/**/*-maxterm.satout
SatPlan/**/*-maxterm-v.cnf
SatPlan/**/*-maxterm-v.satout
