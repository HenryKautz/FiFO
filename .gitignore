# macOS
.DS_Store

# Claude Code local data
.claude/

# Editor / SBCL-alive workspace files and compiled artifacts
.vscode/
*.fasl

# Solver checkouts and build trees fetched by bin/install-solvers.sh
Solvers/

# SatPlan/ is managed manually -- never ignore anything under it
!SatPlan/**

# ... except macOS turds, which the negation above would otherwise re-include,
# leaving them permanently untracked-but-listed in git status.  This must come
# AFTER the negation: git applies the last matching pattern.
SatPlan/**/.DS_Store
